# Per-node rqlite settings, read by rqlited.service.
# Copy to /etc/rqlite/rqlite.env (mode 0600) and set values for this host.

# Unique integer per node. Pick a stable value and never reuse it.
RQLITE_NODE_ID=1

# HTTP API (fleet connects here) and Raft peer traffic.
RQLITE_HTTP_ADDR=192.0.2.20:4001
RQLITE_RAFT_ADDR=192.0.2.20:4002

# Directory for the replicated SQLite database and Raft log.
RQLITE_DATA_DIR=/var/lib/rqlite

# Empty on the first node. On joining nodes:
#RQLITE_JOIN_ARGS=-join 192.0.2.20:4001
