# Copy to /home/incus/incus-fleet.env and chmod 600.
# Generate the token with: openssl rand -hex 32
INCUS_FLEET_AUTH_TOKEN=replace-with-a-random-token

# Optional overrides.
# INCUS_FLEET_LISTEN=0.0.0.0:8080
# INCUS_FLEET_LOG_LEVEL=info

# Database driver: sqlite (default, single node), rqlite, or postgres.
# sqlite  -> a local file, one instance only
# INCUS_FLEET_DATABASE_DSN=/home/incus/data/fleet.db
# rqlite  -> point at any cluster node; the driver discovers the rest
# INCUS_FLEET_DATABASE_DRIVER=rqlite
# INCUS_FLEET_DATABASE_DSN=http://192.0.2.20:4001
# postgres -> a shared server
# INCUS_FLEET_DATABASE_DRIVER=postgres
# INCUS_FLEET_DATABASE_DSN=postgres://incus_fleet:replace-me@127.0.0.1:5432/incus_fleet
