# Example Caddy configuration for two independent incus-fleet instances.
#
# Sessions are stored in memory per app instance, so the UI MUST be pinned to
# one upstream. `lb_policy cookie` sets a separate sticky cookie; do not use
# round-robin for browser traffic.
#
# Replace the hostname and upstream addresses. TLS terminates here; the app
# instances listen on plain HTTP on the private network.

fleet.example.internal {
	encode zstd gzip

	reverse_proxy 192.0.2.20:8080 192.0.2.21:8080 {
		lb_policy cookie incus_fleet_lb
		lb_try_duration 5s
		lb_try_interval 250ms
		fail_duration 30s
		max_fails 2
		health_uri /api/v1/healthz
		health_interval 10s
		health_timeout 2s
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}
