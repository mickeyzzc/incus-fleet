[Unit]
Description=Incus Fleet multi-cluster control plane
Documentation=https://github.com/mickeyzzc/incus-fleet
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=incus-fleet
Group=incus-fleet
WorkingDirectory=/home/incus
EnvironmentFile=/home/incus/incus-fleet.env
ExecStart=/home/incus/bin/incus-fleet -config /home/incus/config.yaml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM

# Hardening. Read-only access to /home/incus plus the specific writable paths.
# NoNewPrivileges must stay off: node network management escalates through the
# sudo whitelist in deploy/nodesudoers, and sudo is a setuid binary that
# NoNewPrivileges would neutralise. PrivateDevices must stay off for the same
# reason: `ip`/`iw`/`nft` need the real network device view.
NoNewPrivileges=false
PrivateTmp=true
PrivateDevices=false
ProtectSystem=strict
ProtectHome=read-only
# SQLite lives in data/; nodenet persists ifupdown snippets and the fleet
# wpa_supplicant config. The private overlay also writes its dnsmasq config
# and the per-overlay systemd unit, so those paths must be writable too.
ReadWritePaths=/home/incus/data /etc/network/interfaces.d /etc/wpa_supplicant /etc/dnsmasq.d /etc/systemd/system/fleet-overlay-dhcp-*.service
ProtectKernelTunables=true
ProtectKernelModules=false
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true

[Install]
WantedBy=multi-user.target
