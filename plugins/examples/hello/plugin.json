{
  "id": "hello",
  "name": "Hello service",
  "description": "Minimal example plugin: deploys a tiny HTTP service on port 8080.",
  "ui_path": "/plugin/hello",
  "wiring": "example.hello_url",
  "image": "debian/13",
  "default_cpu": "1",
